  };

  const handleDisable2FA = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!disable2FAPassword) {
      toast.error(t('Vui lòng nhập mật khẩu hiện tại'));
      return;
    }
    setDisabling2FA(true);
    try {
      const res = await fetchAPI('users/2fa-disable', {
        method: 'POST',
